# ------------------------------------------------------------------ #
# InsightHub environment configuration
#
# Copy this file to `.env.local` and fill in the values.
# Every variable here is read on the server only. Never prefix any of
# them with NEXT_PUBLIC_ — doing so would ship the value to the browser.
# ------------------------------------------------------------------ #

# Numverify — validates phone numbers for the public PhoneCheck module.
# Get one at https://numverify.com/
NUMVERIFY_API_KEY=

# IPstack — resolves an IP address to approximate location, ISP and ASN data.
# Get one at https://ipstack.com/
# Optional: without it, visitors are still tracked but have no location data.
IPSTACK_API_KEY=

# MongoDB connection string — stores accounts, sessions and visitor analytics.
# Local:  mongodb://127.0.0.1:27017/insighthub
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/insighthub
MONGODB_URI=

# HMAC pepper used to derive session token digests.
#
# This is NOT the admin login password. Accounts live in MongoDB and are created
# with `npm run seed:admin`; this value only keys the stored session digests, so a
# database dump on its own cannot be turned into working cookies.
#
# Required in production. Without it the app falls back to a random per-process
# value, which silently signs everyone out on every restart.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Optional. Number of trusted reverse proxies in front of the app (for example
# 1 for Vercel, 2 behind a CDN and load balancer). Used to read the correct
# client IP from x-forwarded-for. Leave unset when the app is reached directly.
TRUSTED_PROXY_COUNT=